# Credenciales MySQL del servicio Java. Completar solo en el .env local.
EUREKABANK_DB_URL=jdbc:mysql://127.0.0.1:3306/eurekabank_gr09?sslMode=DISABLED&allowPublicKeyRetrieval=true
EUREKABANK_DB_USER=usuario_local
EUREKABANK_DB_PASSWORD=

# Connection string SQL Server del servicio .NET. Completar solo en el .env local.
EUREKABANK_DB_CONNECTION_STRING=

# Configuración local de Payara para servicios Java.
PAYARA_HOME=D:/tools/payara-7.2026.10/payara7
PAYARA_DOMAIN=domain1
PAYARA_JAVA_HOME=D:/tools/jdk-25

# Endpoints opcionales para consumidores locales.
EUREKABANK_SOAP_URL=http://localhost:8080/WSEureka
EUREKABANK_REST_URL=http://localhost:8080/api/eureka
EUREKABANK_SOAP_DOTNET_URL=http://localhost:5080/WSEureka
EUREKABANK_REST_DOTNET_URL=http://localhost:5081/
