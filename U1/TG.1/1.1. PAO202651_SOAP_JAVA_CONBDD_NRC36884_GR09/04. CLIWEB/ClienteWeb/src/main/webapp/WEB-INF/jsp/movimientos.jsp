<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,ec.edu.monster.modelo.Movimiento,ec.edu.monster.controlador.VistaHtml" %>
<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Movimientos | EurekaBank</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/monster.css"></head>
<body><main class="shell"><header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/menu"><span class="brand-mark" aria-hidden="true">E</span><span><small>MONSTER · BANCA</small><strong>EurekaBank</strong></span></a><form method="post" action="${pageContext.request.contextPath}/salir"><input type="hidden" name="_csrf" value="${csrf}"><button class="quiet" type="submit">Cerrar sesión</button></form></header>
<a class="back" href="${pageContext.request.contextPath}/menu">← Volver al menú</a><section class="panel"><p class="eyebrow">CONSULTAS</p><h1>Movimientos</h1><form class="inline-form" method="post" action="${pageContext.request.contextPath}/movimientos"><div><label for="cuenta">Número de cuenta</label><input id="cuenta" name="cuenta" maxlength="8" required value="<%= VistaHtml.escapar(request.getAttribute("cuenta")) %>"></div><button type="submit">Consultar</button></form>
<% if (request.getAttribute("error") != null) { %><p class="alert" role="alert"><%= VistaHtml.escapar(request.getAttribute("error")) %></p><% } %>
<% if (request.getAttribute("movimientos") != null) { List<Movimiento> movimientos = (List<Movimiento>) request.getAttribute("movimientos"); if (movimientos.isEmpty()) { %><p class="notice">La cuenta no registra movimientos.</p><% } else { %><div class="table-wrap"><table><caption>Movimientos de la cuenta <%= VistaHtml.escapar(request.getAttribute("cuenta")) %></caption><thead><tr><th scope="col">N.º</th><th scope="col">Fecha</th><th scope="col">Tipo</th><th scope="col">Acción</th><th scope="col">Importe</th></tr></thead><tbody><% for (Movimiento m : movimientos) { %><tr><td><%= m.numero() %></td><td><%= VistaHtml.escapar(m.fecha()) %></td><td><%= VistaHtml.escapar(m.tipo()) %></td><td><%= VistaHtml.escapar(m.accion()) %></td><td><%= VistaHtml.escapar(m.importe()) %></td></tr><% } %></tbody></table></div><% } } %></section></main></body></html>
