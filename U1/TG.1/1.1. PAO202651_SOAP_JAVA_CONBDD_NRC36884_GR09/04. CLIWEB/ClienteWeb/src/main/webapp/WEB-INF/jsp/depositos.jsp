<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.List,ec.edu.monster.modelo.Cuenta" %>
<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Depósitos | EurekaBank</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/monster.css"></head>
<body><main class="shell"><header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/menu"><span class="brand-mark" aria-hidden="true">E</span><span><small>MONSTER · BANCA</small><strong>EurekaBank</strong></span></a><form method="post" action="${pageContext.request.contextPath}/salir"><input type="hidden" name="_csrf" value="${csrf}"><button class="quiet" type="submit">Cerrar sesión</button></form></header><a class="back" href="${pageContext.request.contextPath}/menu">← Volver al menú</a>
<section class="panel form-panel"><p class="eyebrow">OPERACIONES</p><h1>Registrar depósito</h1><p class="muted">Ingrese la cuenta y el importe que desea acreditar.</p>
<% if ("registrado".equals(request.getParameter("resultado"))) { %><p class="success" role="status">Depósito registrado.</p><% } %><% if (request.getAttribute("error") != null) { %><p class="alert" role="alert"><%= ec.edu.monster.controlador.VistaHtml.escapar(request.getAttribute("error")) %></p><% } %>
<form method="post" action="${pageContext.request.contextPath}/depositos"><input type="hidden" name="_csrf" value="${csrf}"><label for="cuenta">Número de cuenta</label><select id="cuenta" name="cuenta" required><% List<Cuenta> cuentas = (List<Cuenta>) session.getAttribute("cuentas"); if (cuentas == null || cuentas.isEmpty()) { %><option value="">No hay cuentas activas asignadas</option><% } else for (Cuenta c : cuentas) { %><option value="<%= ec.edu.monster.controlador.VistaHtml.escapar(c.numero()) %>"><%= ec.edu.monster.controlador.VistaHtml.escapar(c.numero()) %> · <%= ec.edu.monster.controlador.VistaHtml.escapar(c.moneda()) %> <%= ec.edu.monster.controlador.VistaHtml.escapar(c.saldo()) %></option><% } %></select><label for="importe">Importe (USD)</label><input id="importe" name="importe" type="number" min="0.01" max="9999999999.99" step="0.01" inputmode="decimal" required><p class="muted help">El importe debe ser positivo y tener hasta dos decimales.</p><button type="submit">Registrar depósito</button></form></section></main></body></html>
