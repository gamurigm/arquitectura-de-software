<c:UseCases>
<o:UseCase Id="o34">
<a:ObjectID>8EFB8B47-2F95-4110-9A5F-01F7FC8DA75B</a:ObjectID>
<a:Name>CU-01 Iniciar sesión</a:Name>
<a:Code>CU01</a:Code>
<a:CreationDate>1792636095</a:CreationDate>
<a:Creator>GABI</a:Creator>
<a:ModificationDate>1792636095</a:ModificationDate>
<a:Modifier>GABI</a:Modifier>
<a:PreCondition>Servicio SOAP y base de datos disponibles.</a:PreCondition>
<a:PostCondition>El cliente presenta el menú si la operación devuelve 1; no se crea una sesión remota.</a:PostCondition>
<a:Description>Valida las credenciales y habilita el flujo local del cliente.</a:Description>
</o:UseCase>
<o:UseCase Id="o35">
<a:ObjectID>8267ED97-CA4E-4D41-A575-B7DAE6193BA2</a:ObjectID>
<a:Name>CU-02 Consultar movimientos</a:Name>
<a:Code>CU02</a:Code>
<a:CreationDate>1792636095</a:CreationDate>
<a:Creator>GABI</a:Creator>
<a:ModificationDate>1792636095</a:ModificationDate>
<a:Modifier>GABI</a:Modifier>
<a:PreCondition>El usuario llegó al menú del cliente.</a:PreCondition>
<a:PostCondition>Se muestran movimientos ordenados o una lista vacía.</a:PostCondition>
<a:Description>Consulta y presenta los movimientos asociados a una cuenta.</a:Description>
</o:UseCase>
<o:UseCase Id="o36">
<a:ObjectID>F639400D-82DF-4017-B6E3-ECB58D91ED9C</a:ObjectID>
<a:Name>CU-03 Registrar depósito</a:Name>
<a:Code>CU03</a:Code>
<a:CreationDate>1792636095</a:CreationDate>
<a:Creator>GABI</a:Creator>
<a:ModificationDate>1792636095</a:ModificationDate>
<a:Modifier>GABI</a:Modifier>
<a:PreCondition>El usuario llegó al menú; la cuenta está activa.</a:PreCondition>
<a:PostCondition>Saldo y movimiento quedan confirmados en una transacción.</a:PostCondition>
<a:Description>Acredita un importe en una cuenta activa y registra el movimiento.</a:Description>
</o:UseCase>
<o:UseCase Id="o37">
<a:ObjectID>970CF329-72B2-4196-ACC8-915C84A41255</a:ObjectID>
<a:Name>CU-04 Cerrar sesión local</a:Name>
<a:Code>CU04</a:Code>
<a:CreationDate>1792636095</a:CreationDate>
<a:Creator>GABI</a:Creator>
<a:ModificationDate>1792636095</a:ModificationDate>
<a:Modifier>GABI</a:Modifier>
<a:PreCondition>El usuario está en el menú local.</a:PreCondition>
<a:PostCondition>El cliente elimina su estado local; no se llama al servidor.</a:PostCondition>
<a:Description>Sale del menú y retorna al ingreso o finaliza el cliente.</a:Description>
</o:UseCase>
<o:UseCase Id="o38">
<a:ObjectID>4992FD79-402E-424B-980B-5A3658C72D35</a:ObjectID>
<a:Name>CU-05 Validar credenciales</a:Name>
<a:Code>CU05</a:Code>
<a:CreationDate>1792636095</a:CreationDate>
<a:Creator>GABI</a:Creator>
<a:ModificationDate>1792636095</a:ModificationDate>
<a:Modifier>GABI</a:Modifier>
<a:PreCondition>Se recibieron usuario y contraseña.</a:PreCondition>
<a:PostCondition>La credencial se acepta o se rechaza.</a:PostCondition>
<a:Description>Comprueba las entradas y verifica el hash almacenado.</a:Description>
</o:UseCase>
<o:UseCase Id="o39">
<a:ObjectID>EFBDED59-5CA4-4085-874A-DAE34BEB2A16</a:ObjectID>
<a:Name>CU-06 Validar cuenta</a:Name>
<a:Code>CU06</a:Code>
<a:CreationDate>1792636095</a:CreationDate>
<a:Creator>GABI</a:Creator>
<a:ModificationDate>1792636095</a:ModificationDate>
<a:Modifier>GABI</a:Modifier>
<a:PreCondition>Se recibió un identificador de cuenta.</a:PreCondition>
<a:PostCondition>La cuenta puede consultarse o procesarse.</a:PostCondition>
<a:Description>Rechaza una cuenta vacía o de más de ocho caracteres.</a:Description>
</o:UseCase>
<o:UseCase Id="o40">
<a:ObjectID>9B4407D3-78A5-459E-9FED-CF6AE38B3B74</a:ObjectID>
<a:Name>CU-07 Validar datos del depósito</a:Name>
<a:Code>CU07</a:Code>
<a:CreationDate>1792636095</a:CreationDate>
<a:Creator>GABI</a:Creator>
<a:ModificationDate>1792636095</a:ModificationDate>
