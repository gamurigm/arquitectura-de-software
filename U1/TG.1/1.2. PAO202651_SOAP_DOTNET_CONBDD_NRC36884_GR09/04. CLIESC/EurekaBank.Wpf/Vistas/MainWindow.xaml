<Window x:Class="ec.edu.monster.Vistas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EurekaBank" Height="760" Width="1000" MinHeight="620" MinWidth="760"
        Background="{StaticResource Fondo}" Foreground="#17324D" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid x:Name="PanelLogin" Width="390" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="EUREKABANK" Foreground="{StaticResource Acento}" FontSize="14" FontWeight="Bold" />
                <TextBlock Text="Iniciar sesión" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,24" />
                <TextBlock Text="Usuario" />
                <TextBox x:Name="Usuario" />
                <TextBlock Text="Contraseña" />
                <PasswordBox x:Name="Contrasena" Margin="0,6,0,14" Padding="10" />
                <Button Content="Ingresar" Click="IniciarSesion_Click" Background="{StaticResource Acento}" Foreground="White" FontWeight="Bold" />
                <TextBlock x:Name="MensajeLogin" Foreground="#A33445" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>

        <DockPanel x:Name="PanelBanco" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
                <DockPanel>
                    <Button Content="Cerrar sesión" DockPanel.Dock="Right" Click="CerrarSesion_Click" />
                    <TextBlock Text="Mis movimientos" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,20" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cuenta" VerticalAlignment="Center" />
                    <ComboBox x:Name="Cuenta" Width="210" Margin="12,0,12,0" DisplayMemberPath="Etiqueta" SelectedValuePath="Numero" />
                    <Button Content="Consultar" Click="Consultar_Click" />
                    <TextBlock Text="Depósito" VerticalAlignment="Center" Margin="20,0,0,0" />
                    <TextBox x:Name="Importe" Width="120" Margin="12,0,12,0" />
                    <Button Content="Registrar" Click="Depositar_Click" Background="{StaticResource Acento}" Foreground="White" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                    <TextBlock Text="Origen" VerticalAlignment="Center" />
                    <ComboBox x:Name="CuentaOrigen" Width="180" Margin="8,0,8,0" DisplayMemberPath="Etiqueta" SelectedValuePath="Numero" />
                    <TextBlock Text="Destino" VerticalAlignment="Center" />
                    <TextBox x:Name="CuentaDestino" Width="130" Margin="8,0,8,0" MaxLength="8" />
                    <TextBlock Text="Importe" VerticalAlignment="Center" />
                    <TextBox x:Name="ImporteTransferencia" Width="120" Margin="8,0,8,0" />
                    <Button Content="Transferir" Click="Transferir_Click" Background="{StaticResource Acento}" Foreground="White" />
                </StackPanel>
                <TextBlock x:Name="MensajeBanco" Foreground="{StaticResource Acento}" Margin="0,10,0,12" />
            </StackPanel>
            <Border Background="{StaticResource Superficie}" CornerRadius="14" Padding="10">
                    <DataGrid x:Name="TablaMovimientos" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          Background="{StaticResource Superficie}" Foreground="#17324D" BorderThickness="0" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N.º" Binding="{Binding Nromov}" Width="70" />
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=yyyy-MM-dd}" Width="130" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="*" />
                        <DataGridTextColumn Header="Acción" Binding="{Binding Accion}" Width="120" />
                        <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=N2}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock x:Name="Saldo" DockPanel.Dock="Bottom" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,0" />
        </DockPanel>
    </Grid>
</Window>
