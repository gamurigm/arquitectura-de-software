<Application x:Class="ec.edu.monster.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Vistas/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Fondo" Color="#0B1020" />
        <SolidColorBrush x:Key="Superficie" Color="#121C30" />
        <SolidColorBrush x:Key="Acento" Color="#52E0D2" />
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,14" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,6,8,6" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
    </Application.Resources>
</Application>
