<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ec.edu.monster.App">
    <Application.Resources>
        <Color x:Key="Fondo">#F3F7FA</Color>
        <Color x:Key="Superficie">#FFFFFF</Color>
        <Color x:Key="Acento">#087F7B</Color>
        <Color x:Key="Texto">#17324D</Color>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="#17324D" />
            <Setter Property="PlaceholderColor" Value="#667B8E" />
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="#087F7B" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="MinimumHeightRequest" Value="46" />
        </Style>
    </Application.Resources>
</Application>
