<Application x:Class="EurekaBank.ClienteEscritorio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="Fondo" Color="#F3F7FA" />
        <SolidColorBrush x:Key="Superficie" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Acento" Color="#087F7B" />
        <SolidColorBrush x:Key="Texto" Color="#17324D" />
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,12" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="BorderBrush" Value="#B9CAD7" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,6,0,14" />
            <Setter Property="Padding" Value="9" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#087F7B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,6,8,6" />
        </Style>
    </Application.Resources>
</Application>
