<Window x:Class="EurekaBank.ClienteEscritorio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EurekaBank | Monster" Height="760" Width="900"
        Background="{StaticResource Fondo}" Foreground="{StaticResource Texto}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <StackPanel x:Name="LoginPanel" Width="360" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Superficie}">
            <TextBlock Text="EUREKABANK · BANCA PERSONAL" Foreground="{StaticResource Acento}" FontSize="14" FontWeight="Bold" />
            <TextBlock Text="Iniciar sesión" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,22" />
            <TextBlock Text="Usuario" />
            <TextBox x:Name="UsuarioBox" Margin="0,6,0,14" Padding="10" />
            <TextBlock Text="Contraseña" />
            <PasswordBox x:Name="ContrasenaBox" Margin="0,6,0,18" Padding="10" />
            <Button Content="Ingresar" Click="IniciarSesion_Click" Padding="12" Background="{StaticResource Acento}" />
        </StackPanel>
        <StackPanel x:Name="BancoPanel" Visibility="Collapsed">
            <DockPanel Margin="0,0,0,22">
                <Button Content="Cerrar sesión" Click="CerrarSesion_Click" DockPanel.Dock="Right" Padding="10,6" />
                <TextBlock x:Name="SaludoText" FontSize="24" FontWeight="SemiBold" />
            </DockPanel>
            <Border Background="{StaticResource Superficie}" Padding="18" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="Consulta de movimientos" FontSize="18" FontWeight="SemiBold" />
                    <DockPanel Margin="0,12,0,12">
                        <ComboBox x:Name="CuentaConsultaBox" Width="220" Padding="8" />
                        <Button Content="Consultar" Click="Consultar_Click" Margin="10,0,0,0" Padding="12,6" />
                    </DockPanel>
                    <DataGrid x:Name="MovimientosGrid" Height="260" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" Background="{StaticResource Superficie}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N.º" Binding="{Binding Numero}" />
                            <DataGridTextColumn Header="Cuenta" Binding="{Binding Cuenta}" />
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:O}}" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" />
                            <DataGridTextColumn Header="Acción" Binding="{Binding Accion}" />
                            <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat={}{0:N2}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource Superficie}" Padding="18" CornerRadius="12" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Registrar depósito" FontSize="18" FontWeight="SemiBold" />
                    <DockPanel Margin="0,12,0,0">
                        <ComboBox x:Name="CuentaDepositoBox" Width="220" Padding="8" />
                        <TextBox x:Name="ImporteBox" Width="150" Margin="10,0,0,0" Padding="8" />
                        <Button Content="Depositar" Click="Depositar_Click" Margin="10,0,0,0" Padding="12,6" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource Superficie}" Padding="18" CornerRadius="12" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Transferir" FontSize="18" FontWeight="SemiBold" />
                    <DockPanel Margin="0,12,0,0">
                        <ComboBox x:Name="CuentaOrigenBox" Width="180" Padding="8" ToolTip="Cuenta origen" />
                        <TextBox x:Name="CuentaDestinoBox" Width="180" Margin="8,0,0,0" Padding="8" ToolTip="Cuenta destino" />
                        <TextBox x:Name="ImporteTransferenciaBox" Width="130" Margin="8,0,0,0" Padding="8" ToolTip="Importe" />
                        <Button Content="Transferir" Click="Transferir_Click" Margin="8,0,0,0" Padding="12,6" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="MensajeText" Margin="0,14,0,0" Foreground="{StaticResource Acento}" />
        </StackPanel>
    </Grid>
</Window>
