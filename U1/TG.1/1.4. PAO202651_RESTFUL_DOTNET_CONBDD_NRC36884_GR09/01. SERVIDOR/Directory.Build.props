<Project>
  <PropertyGroup>
    <BankBuildRoot Condition="'$(BankBuildRoot)' == ''">D:\tools\BankGR09</BankBuildRoot>
    <BankPackagesRoot Condition="'$(BankPackagesRoot)' == ''">D:\NuGet\packages</BankPackagesRoot>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BaseIntermediateOutputPath>$(BankBuildRoot)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(BankBuildRoot)\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
    <RestorePackagesPath>$(BankPackagesRoot)</RestorePackagesPath>
  </PropertyGroup>
</Project>
