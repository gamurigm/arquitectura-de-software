<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#555555" /> <!-- Color cuando el botón es presionado -->
            <corners android:radius="15dp" /> <!-- Bordes redondeados -->
            <stroke android:width="2dp" android:color="#FFFFFF" /> <!-- Borde blanco -->
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" /> <!-- Color normal del botón -->
            <corners android:radius="15dp" /> <!-- Bordes redondeados -->
            <stroke android:width="2dp" android:color="#FFFFFF" /> <!-- Borde blanco -->
        </shape>
    </item>
</selector>
