<Window x:Class="Celulares.Escritorio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Celulares GR09" Width="1200" Height="820" MinWidth="780" MinHeight="600" Background="#0B1020" Foreground="#F5F7FB" FontFamily="Segoe UI" Loaded="AlCargar">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Padding" Value="7"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="0,6,8,4"/><Setter Property="Padding" Value="12,8"/><Setter Property="Background" Value="#52E0D2"/><Setter Property="Foreground" Value="#0B1020"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#F5F7FB"/><Setter Property="Background" Value="#121C30"/><Setter Property="BorderBrush" Value="#52627A"/><Setter Property="Padding" Value="15"/><Setter Property="Margin" Value="0,8,12,8"/></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="Celulares GR09" FontSize="28" FontWeight="Bold" Foreground="#52E0D2"/>
      <TextBlock Text="Catálogo, ventas y amortización" FontSize="16" Margin="0,2,0,12"/>
      <TextBlock x:Name="Estado" TextWrapping="Wrap" Foreground="#FFCD70" Margin="0,0,0,8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <GroupBox Header="Catálogo" Grid.Column="0"><StackPanel>
          <DataGrid x:Name="Catalogo" Height="190" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="SeleccionarCelular" Background="White" Foreground="Black">
            <DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}"/><DataGridTextColumn Header="Celular" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=F2}"/></DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Nombre"/><TextBox x:Name="NombreCelular" MaxLength="100"/>
          <TextBlock Text="Precio de lista"/><TextBox x:Name="PrecioCelular"/>
          <WrapPanel><Button Content="Nuevo" Click="NuevoCelular"/><Button Content="Guardar" Click="GuardarCelular"/><Button Content="Desactivar" Click="DesactivarCelular"/><Button Content="Actualizar catálogo" Click="ActualizarCatalogo"/></WrapPanel>
        </StackPanel></GroupBox>
        <GroupBox Header="Registrar venta" Grid.Column="1"><StackPanel>
          <TextBlock Text="En efectivo se descuenta el 42%. Crédito: 3 a 18 cuotas." TextWrapping="Wrap"/>
          <TextBlock Text="Cédula"/><TextBox x:Name="Cedula" MaxLength="100"/>
          <TextBlock Text="Nombre del comprador"/><TextBox x:Name="Comprador" MaxLength="100"/>
          <TextBlock Text="Celular"/><ComboBox x:Name="CelularVenta" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>
          <TextBlock Text="Forma de pago"/><ComboBox x:Name="FormaPago" SelectedIndex="0"><ComboBoxItem Content="Efectivo" Tag="EFECTIVO"/><ComboBoxItem Content="Crédito directo" Tag="CREDITO_DIRECTO"/></ComboBox>
          <TextBlock Text="Cuotas para crédito"/><TextBox x:Name="Cuotas"/>
          <WrapPanel><Button Content="Confirmar venta" Click="Vender"/><Button Content="Nueva venta" Click="NuevaVenta"/></WrapPanel>
        </StackPanel></GroupBox>
      </Grid>
      <GroupBox Header="Consultar factura y amortización"><StackPanel>
        <WrapPanel><TextBlock Text="Número de factura" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="FacturaId" Width="130"/><Button Content="Consultar" Click="ConsultarFactura"/></WrapPanel>
        <TextBlock x:Name="DetalleFactura" TextWrapping="Wrap" Margin="0,8,0,8"/>
        <DataGrid x:Name="TablaCuotas" Height="200" IsReadOnly="True" AutoGenerateColumns="False" Background="White" Foreground="Black">
          <DataGrid.Columns><DataGridTextColumn Header="Cuota" Binding="{Binding NumeroCuota}"/><DataGridTextColumn Header="Fecha" Binding="{Binding FechaPago}"/><DataGridTextColumn Header="Valor" Binding="{Binding ValorCuota, StringFormat=F2}"/><DataGridTextColumn Header="Interés" Binding="{Binding InteresPagado, StringFormat=F2}"/><DataGridTextColumn Header="Capital" Binding="{Binding CapitalPagado, StringFormat=F2}"/><DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, StringFormat=F2}"/></DataGrid.Columns>
        </DataGrid>
      </StackPanel></GroupBox>
    </StackPanel>
  </ScrollViewer>
</Window>
