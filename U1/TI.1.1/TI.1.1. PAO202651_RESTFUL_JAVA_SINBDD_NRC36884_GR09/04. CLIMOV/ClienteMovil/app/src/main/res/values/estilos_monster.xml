<?xml version="1.0" ?>
<resources>
    <style name="EtiquetaMonster">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#F4F7FC</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="CampoMonster">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/fondo_campo</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:textColor">#F4F7FC</item>
        <item name="android:textColorHint">#A9B7CB</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="SelectorMonster">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/fondo_selector</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">36dp</item>
        <item name="android:popupBackground">#17243A</item>
        <item name="android:spinnerMode">dropdown</item>
    </style>
    <style name="BotonMonster" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/fondo_boton_primario</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#0B1020</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="BotonSecundarioMonster" parent="BotonMonster">
        <item name="android:background">@drawable/fondo_boton_secundario</item>
        <item name="android:textColor">#A78BFA</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
