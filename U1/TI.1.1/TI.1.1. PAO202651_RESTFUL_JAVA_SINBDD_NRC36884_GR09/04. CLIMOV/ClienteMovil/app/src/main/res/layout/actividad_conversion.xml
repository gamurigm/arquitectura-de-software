<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="14dp"
        android:background="@drawable/fondo_tarjeta"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conversor de unidades"
            android:textColor="@color/texto"
            android:textSize="28sp"
            android:textStyle="bold" />

        <View
            android:layout_width="44dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:background="@color/azul" />

        <TextView
            android:id="@+id/textoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/texto_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/magnitud"
            android:textColor="@color/texto"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerMagnitud"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="@color/azul" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unidad_origen"
            android:textColor="@color/texto"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerOrigen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="@color/azul" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unidad_destino"
            android:textColor="@color/texto"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerDestino"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="@color/azul" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/valor"
            android:textColor="@color/texto"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/campoValor"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/fondo_campo"
            android:inputType="numberDecimal|numberSigned"
            android:textColor="@color/texto"
            android:textColorHint="@color/texto_muted" />

        <Button
            android:id="@+id/botonConvertir"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/azul"
            android:text="@string/convertir"
            android:textColor="@color/negro_fondo" />

        <TextView
            android:id="@+id/textoResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/exito"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/texto"
            android:textSize="14sp" />

        <Button
            android:id="@+id/botonSalir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/panel"
            android:text="@string/cerrar_sesion"
            android:textColor="@color/texto_muted" />
    </LinearLayout>
</ScrollView>
