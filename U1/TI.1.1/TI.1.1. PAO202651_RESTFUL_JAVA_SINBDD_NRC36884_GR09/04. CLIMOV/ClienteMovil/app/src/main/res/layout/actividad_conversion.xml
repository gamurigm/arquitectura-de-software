<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="146dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/fondo_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MONSTER  /  REST JAVA"
                    android:textColor="@color/menta"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Convierte\nal instante"
                    android:textColor="@color/texto"
                    android:textSize="23sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/textoUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/texto_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="82dp"
                android:layout_height="126dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/fondo_imagen"
                android:clipToOutline="true"
                android:contentDescription="Monster, mascota del conversor"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/imagen_inicio_sesion" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_tarjeta"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nueva conversión"
                android:textColor="@color/texto"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="Elige magnitud y unidades."
                android:textColor="@color/texto_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/spinnerMagnitud"
                android:text="MAGNITUD"
                android:textColor="@color/texto"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <Spinner
                android:id="@+id/spinnerMagnitud"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/fondo_selector"
                android:paddingHorizontal="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/campoValor"
                android:text="VALOR"
                android:textColor="@color/texto"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <EditText
                android:id="@+id/campoValor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/fondo_campo"
                android:hint="Ej. 12,5"
                android:inputType="numberDecimal|numberSigned"
                android:paddingHorizontal="12dp"
                android:textColor="@color/texto"
                android:textColorHint="@color/texto_muted"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/spinnerOrigen"
                        android:text="DESDE"
                        android:textColor="@color/texto"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <Spinner
                        android:id="@+id/spinnerOrigen"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/fondo_selector"
                        android:paddingHorizontal="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/spinnerDestino"
                        android:text="HASTA"
                        android:textColor="@color/texto"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <Spinner
                        android:id="@+id/spinnerDestino"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/fondo_selector"
                        android:paddingHorizontal="8dp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/botonConvertir"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/fondo_boton_primario"
                android:text="Convertir ahora"
                android:textAllCaps="false"
                android:textColor="@color/negro_fondo"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/fondo_resultado"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RESULTADO"
                    android:textColor="@color/menta"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/textoResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="start"
                    android:textColor="@color/texto"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/textoMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/texto_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/botonSalir"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/fondo_boton_secundario"
                android:text="Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="@color/texto_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
