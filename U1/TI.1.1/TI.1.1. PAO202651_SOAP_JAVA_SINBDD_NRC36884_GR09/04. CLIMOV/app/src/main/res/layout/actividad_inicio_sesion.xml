<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808"
    android:fillViewport="true"
    tools:context=".vista.ActividadInicioSesion">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="150dp"
            android:contentDescription="Monstruo"
            android:scaleType="centerCrop"
            android:src="@drawable/monsterlogin" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ingrese sus credenciales"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/campoUsuario"
            android:text="Usuario"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/campoUsuario"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_white"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="#0F0F0F"
            android:textColorHint="#5C5C5C" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:labelFor="@id/campoContrasenia"
            android:text="Contraseña"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/campoContrasenia"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_white"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:textColor="#0F0F0F" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonInicioSesion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_blue"
            android:text="INICIAR SESIÓN"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>
</ScrollView>
