<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/fondo_pantalla" android:fillViewport="true" android:fitsSystemWindows="true" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="20dp" android:paddingEnd="20dp" android:paddingBottom="32dp" android:focusableInTouchMode="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="20dp">
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:background="@drawable/fondo_marca" android:text="M" android:textColor="#0B1020" android:textSize="23sp" android:textStyle="bold" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Monster" android:textColor="#F4F7FC" android:textSize="20sp" android:fontFamily="sans-serif-medium"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Conversor de unidades" android:textColor="#A9B7CB" android:textSize="12sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GR09" android:textColor="#A78BFA" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/fondo_tarjeta" android:padding="22dp">
            <!-- ── Header con botón salir ── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nueva conversión" android:textColor="#F4F7FC" android:textSize="23sp" android:fontFamily="sans-serif-medium"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/botonCerrarSesion" style="@style/BotonSecundarioMonster" android:layout_width="wrap_content" android:layout_marginStart="10dp" android:text="Salir"/>
            </LinearLayout>
            <!-- ── Sección de conversión ── -->
            <TextView style="@style/EtiquetaMonster" android:text="Magnitud" android:labelFor="@id/selectorTipoConversion"/>
            <Spinner android:id="@+id/selectorTipoConversion" style="@style/SelectorMonster" android:contentDescription="Magnitud"/>
            <TextView style="@style/EtiquetaMonster" android:text="Valor a convertir" android:labelFor="@id/campoValor"/>
            <EditText android:id="@+id/campoValor" style="@style/CampoMonster" android:text="" android:hint="Ej. 12,5" android:inputType="numberDecimal|numberSigned" android:textSize="24sp" android:imeOptions="actionDone"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Unidades" android:textColor="#F4F7FC" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/botonIntercambiar" style="@style/BotonSecundarioMonster" android:layout_width="wrap_content" android:text="⇅  Intercambiar" android:contentDescription="Intercambiar unidad de origen y destino"/>
            </LinearLayout>
            <TextView style="@style/EtiquetaMonster" android:text="Desde" android:labelFor="@id/selectorUnidadOrigen"/>
            <Spinner android:id="@+id/selectorUnidadOrigen" style="@style/SelectorMonster" android:contentDescription="Unidad de origen"/>
            <TextView style="@style/EtiquetaMonster" android:text="Hasta" android:labelFor="@id/selectorUnidadDestino"/>
            <Spinner android:id="@+id/selectorUnidadDestino" style="@style/SelectorMonster" android:contentDescription="Unidad de destino"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/botonConvertir" style="@style/BotonMonster" android:layout_marginTop="22dp" android:text="Convertir ahora"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/fondo_resultado" android:padding="18dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Resultado" android:textColor="#C7D2E3" android:textSize="13sp"/>
                <EditText android:id="@+id/campoResultado" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:background="@null" android:focusable="false" android:cursorVisible="false" android:inputType="none" android:hint="Tu resultado aparecerá aquí" android:textColor="#52E0D2" android:textColorHint="#A9B7CB" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:accessibilityLiveRegion="polite"/>
            </LinearLayout>
            <TextView android:id="@+id/textoEstado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="#FF8585" android:textSize="14sp" android:accessibilityLiveRegion="polite"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
