<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020"
    android:fillViewport="true"
    tools:context="ec.edu.monster.vista.ActividadConversion">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="14dp"
        android:background="@drawable/fondo_tarjeta"
        android:padding="24dp">

        <!-- ── Header con botón salir ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/botonCerrarSesion"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/fondo_boton_secundario"
            android:paddingHorizontal="16dp"
            android:text="SALIR"
            android:textColor="#A9B7CB"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#2D3A55" />

        <!-- ── Sección de conversión ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Conversor de unidades"
            android:textColor="#F4F7FC"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/selectorTipoConversion"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#52E0D2"
            android:popupBackground="#121C30" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Unidad de origen"
                    android:textColor="#F4F7FC"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/selectorUnidadOrigen"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#52E0D2"
                    android:popupBackground="#121C30" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Valor de origen"
                    android:textColor="#A9B7CB"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/campoValor"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/fondo_campo"
                    android:hint="0.0"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingHorizontal="12dp"
                    android:textColor="#F4F7FC"
                    android:textColorHint="#A9B7CB" />
            </LinearLayout>

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="8dp"
                android:contentDescription="Mano"
                android:scaleType="fitCenter"
                android:rotation="90"
                android:src="@drawable/flecha40px" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Unidad de destino"
                    android:textColor="#F4F7FC"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/selectorUnidadDestino"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#52E0D2"
                    android:popupBackground="#121C30" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Resultado"
                    android:textColor="#A9B7CB"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/campoResultado"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/fondo_campo"
                    android:focusable="false"
                    android:hint="Resultado"
                    android:inputType="none"
                    android:paddingHorizontal="12dp"
                    android:textColor="#52E0D2"
                    android:textColorHint="#A9B7CB" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/botonConvertir"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/fondo_boton_primario"
            android:text="CONVERTIR"
            android:textAllCaps="true"
            android:textColor="#0B1020"
            android:textSize="19sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <TextView
            android:id="@+id/textoEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Listo"
            android:textColor="#F4F7FC"
            android:textSize="14sp" />
    </LinearLayout>

</ScrollView>
