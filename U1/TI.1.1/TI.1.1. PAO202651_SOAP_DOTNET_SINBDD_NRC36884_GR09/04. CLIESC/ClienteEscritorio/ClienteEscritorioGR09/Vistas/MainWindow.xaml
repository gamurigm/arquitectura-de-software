<Window x:Class="ClienteEscritorioGR09.Vistas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conversor de Unidades Monster GR09"
        Height="670" Width="760" MinHeight="600" MinWidth="600"
        WindowStartupLocation="CenterScreen" Background="#F3F6F9">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Margin="28" Padding="28" Background="White" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="Conversor de Unidades" FontSize="28" FontWeight="Bold" Foreground="#172B4D"/>
                <TextBlock Text="SOAP .NET · GR09" Margin="0,4,0,22" Foreground="#526581"/>

                <StackPanel x:Name="PanelLogin">
                    <TextBlock Text="Iniciar sesión" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Usuario"/>
                    <TextBox x:Name="UsuarioBox" Height="34" Margin="0,4,0,12" Padding="8"/>
                    <TextBlock Text="Contraseña"/>
                    <PasswordBox x:Name="ContraseniaBox" Height="34" Margin="0,4,0,14" Padding="8"/>
                    <Button Content="Iniciar sesión" Height="38" Click="IniciarSesion_Click"/>
                </StackPanel>

                <StackPanel x:Name="PanelConversor" Visibility="Collapsed">
                    <TextBlock Text="Nueva conversión" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Magnitud"/>
                    <ComboBox x:Name="MagnitudBox" Height="34" Margin="0,4,0,12"
                              SelectionChanged="Magnitud_SelectionChanged"/>
                    <TextBlock Text="Valor"/>
                    <TextBox x:Name="ValorBox" Height="34" Margin="0,4,0,12" Padding="8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Desde"/>
                            <ComboBox x:Name="UnidadInicialBox" Height="34" Margin="0,4,0,12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hasta"/>
                            <ComboBox x:Name="UnidadFinalBox" Height="34" Margin="0,4,0,12"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="Convertir" Height="38" Click="Convertir_Click"/>
                    <TextBlock x:Name="ResultadoText" FontSize="18" FontWeight="SemiBold"
                               Margin="0,14,0,18" Foreground="#087E5B"/>

                    <Expander Header="Cambiar contraseña" Margin="0,0,0,12">
                        <StackPanel Margin="0,10,0,4">
                            <PasswordBox x:Name="ContraseniaActualBox" Height="34" Margin="0,4,0,10" Padding="8"/>
                            <PasswordBox x:Name="ContraseniaNuevaBox" Height="34" Margin="0,4,0,10" Padding="8"/>
                            <Button Content="Actualizar contraseña" Height="36" Click="CambiarContrasenia_Click"/>
                        </StackPanel>
                    </Expander>
                    <Button Content="Cerrar sesión" Height="36" Click="CerrarSesion_Click"/>
                </StackPanel>

                <TextBlock x:Name="EstadoText" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#9B2C2C"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
