<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClienteMovilGR09.Vistas.PaginaPrincipal"
             Shell.NavBarIsVisible="False"
             Title="Conversor de unidades"
             BackgroundColor="#08111F">
    <ScrollView>
        <VerticalStackLayout Padding="20,18" Spacing="16">
            <Border HorizontalOptions="Start" Padding="12,7" BackgroundColor="#102832"
                    Stroke="#28515A" StrokeShape="RoundRectangle 18">
                <Label Text="●  MONSTER   /   SOAP .NET · GR09" TextColor="#72E8D7"
                       FontSize="12" FontAttributes="Bold" CharacterSpacing="0.8" />
            </Border>

            <Border Padding="18" Stroke="#31515A" StrokeShape="RoundRectangle 26">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#15363D" Offset="0.0" />
                        <GradientStop Color="#1D1D35" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,108" ColumnSpacing="10">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="CONVIERTE EN SEGUNDOS" TextColor="#72E8D7"
                               FontSize="11" FontAttributes="Bold" CharacterSpacing="1.1" />
                        <Label Text="Unidades,&#10;sin enredos" TextColor="#F4F7FC"
                               FontSize="27" FontAttributes="Bold" LineHeight="1.05" />
                        <Label Text="Longitud · masa · temperatura" TextColor="#B9C7D9"
                               FontSize="13" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Padding="0" Stroke="#637184"
                            StrokeShape="RoundRectangle 20" BackgroundColor="#111827">
                        <Image Source="imagen_inicio_sesion.jpg" HeightRequest="166" WidthRequest="108"
                               Aspect="AspectFill" SemanticProperties.Description="Monster, mascota del conversor" />
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="TarjetaInicioSesion" Stroke="#29384F" StrokeShape="RoundRectangle 24"
                    BackgroundColor="#111B2B" Padding="20">
                <VerticalStackLayout x:Name="PanelInicioSesion" Spacing="10">
                    <Label Text="Tu espacio" FontSize="23" FontAttributes="Bold" TextColor="#F4F7FC" />
                    <Label Text="Ingresa tus credenciales para continuar." FontSize="14" TextColor="#A9B7CB" />
                    <Label Text="USUARIO" FontSize="12" FontAttributes="Bold" CharacterSpacing="0.7"
                           TextColor="#DCE6F3" Margin="0,7,0,0" />
                    <Border Stroke="#33435C" BackgroundColor="#17243A"
                            StrokeShape="RoundRectangle 14" Padding="12,0">
                        <Entry x:Name="UsuarioEntry" Text="Monster" Placeholder="Usuario" ReturnType="Next"
                               HeightRequest="52" BackgroundColor="Transparent" TextColor="#F4F7FC"
                               PlaceholderColor="#A9B7CB" FontSize="16" />
                    </Border>
                    <Label Text="CONTRASEÑA" FontSize="12" FontAttributes="Bold" CharacterSpacing="0.7"
                           TextColor="#DCE6F3" Margin="0,2,0,0" />
                    <Border Stroke="#33435C" BackgroundColor="#17243A"
                            StrokeShape="RoundRectangle 14" Padding="12,0">
                        <Entry x:Name="ContraseniaEntry" Text="Monster9" Placeholder="Contraseña" IsPassword="True"
                               ReturnType="Go" HeightRequest="52" BackgroundColor="Transparent"
                               TextColor="#F4F7FC" PlaceholderColor="#A9B7CB" FontSize="16" />
                    </Border>
                    <Button Text="Entrar al conversor" Clicked="AlPulsarIniciarSesion"
                            HeightRequest="54" CornerRadius="16" BackgroundColor="#52E0D2"
                            TextColor="#08111F" FontSize="16" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="PanelConversor" IsVisible="False" Stroke="#29384F"
                    StrokeShape="RoundRectangle 24" BackgroundColor="#111B2B" Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                            <Label Text="TU SESIÓN" TextColor="#72E8D7" FontSize="11"
                                   FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Text="Nueva conversión" FontSize="22" FontAttributes="Bold"
                                   TextColor="#F4F7FC" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Salir" Clicked="AlPulsarCerrarSesion"
                                HeightRequest="42" CornerRadius="14" Padding="16,8"
                                BackgroundColor="#1B2A40" TextColor="#DCE6F3" />
                    </Grid>
                    <Label Text="MAGNITUD" FontAttributes="Bold" FontSize="12"
                           CharacterSpacing="0.7" TextColor="#DCE6F3" />
                    <Border Stroke="#33435C" BackgroundColor="#17243A"
                            StrokeShape="RoundRectangle 14" Padding="12,0">
                        <Picker x:Name="TipoPicker" Title="Elige qué convertir" SelectedIndexChanged="AlCambiarTipo"
                                HeightRequest="52" BackgroundColor="Transparent" TextColor="#F4F7FC"
                                TitleColor="#A9B7CB">
                            <Picker.Items>
                                <x:String>Longitud</x:String>
                                <x:String>Masa</x:String>
                                <x:String>Temperatura</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>
                    <Label Text="VALOR" FontAttributes="Bold" FontSize="12"
                           CharacterSpacing="0.7" TextColor="#DCE6F3" />
                    <Border Stroke="#33435C" BackgroundColor="#17243A"
                            StrokeShape="RoundRectangle 14" Padding="12,0">
                        <Entry x:Name="ValorEntry" Placeholder="Ej. 12,5" Keyboard="Numeric"
                               HeightRequest="52" BackgroundColor="Transparent" TextColor="#F4F7FC"
                               PlaceholderColor="#A9B7CB" FontSize="17" />
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="DESDE" FontAttributes="Bold" FontSize="12"
                                   CharacterSpacing="0.7" TextColor="#DCE6F3" />
                            <Border Stroke="#33435C" BackgroundColor="#17243A"
                                    StrokeShape="RoundRectangle 14" Padding="12,0">
                                <Picker x:Name="UnidadInicialPicker" Title="Unidad de origen"
                                        HeightRequest="52" BackgroundColor="Transparent"
                                        TextColor="#F4F7FC" TitleColor="#A9B7CB" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="7">
                            <Label Text="HASTA" FontAttributes="Bold" FontSize="12"
                                   CharacterSpacing="0.7" TextColor="#DCE6F3" />
                            <Border Stroke="#33435C" BackgroundColor="#17243A"
                                    StrokeShape="RoundRectangle 14" Padding="12,0">
                                <Picker x:Name="UnidadFinalPicker" Title="Unidad de destino"
                                        HeightRequest="52" BackgroundColor="Transparent"
                                        TextColor="#F4F7FC" TitleColor="#A9B7CB" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <Button Text="Convertir ahora" Clicked="AlPulsarConvertir"
                            HeightRequest="54" CornerRadius="16" BackgroundColor="#52E0D2"
                            TextColor="#08111F" FontSize="16" FontAttributes="Bold" />
                    <Border Padding="16" Stroke="#38666A" BackgroundColor="#142B35"
                            StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="RESULTADO" TextColor="#72E8D7" FontSize="11"
                                   FontAttributes="Bold" CharacterSpacing="1" />
                            <Label x:Name="ResultadoLabel" FontSize="20" FontAttributes="Bold"
                                   TextColor="#F4F7FC" />
                        </VerticalStackLayout>
                    </Border>
                    <BoxView HeightRequest="1" Color="#29384F" Margin="0,4" />
                    <Label Text="Cambiar contraseña" FontSize="18" FontAttributes="Bold"
                           TextColor="#F4F7FC" />
                    <Border Stroke="#33435C" BackgroundColor="#17243A"
                            StrokeShape="RoundRectangle 14" Padding="12,0">
                        <Entry x:Name="ContraseniaActualEntry" Placeholder="Contraseña actual" IsPassword="True"
                               HeightRequest="52" BackgroundColor="Transparent" TextColor="#F4F7FC"
                               PlaceholderColor="#A9B7CB" />
                    </Border>
                    <Border Stroke="#33435C" BackgroundColor="#17243A"
                            StrokeShape="RoundRectangle 14" Padding="12,0">
                        <Entry x:Name="ContraseniaNuevaEntry" Placeholder="Contraseña nueva" IsPassword="True"
                               HeightRequest="52" BackgroundColor="Transparent" TextColor="#F4F7FC"
                               PlaceholderColor="#A9B7CB" />
                    </Border>
                    <Button Text="Actualizar contraseña" Clicked="AlPulsarCambiarContrasenia"
                            HeightRequest="50" CornerRadius="15" BackgroundColor="#1B2A40"
                            TextColor="#F4F7FC" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="MensajeLabel" IsVisible="False" Padding="12" FontSize="14"
                   TextColor="#FF9A9A" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
