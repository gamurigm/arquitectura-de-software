<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClienteMovilGR09.Vistas.PaginaPrincipal"
             Title="Conversor de unidades"
             BackgroundColor="#0B1020">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="20">
            <VerticalStackLayout Spacing="4">
                <Label Text="Conversor de unidades" FontSize="30" FontAttributes="Bold" TextColor="#F4F7FC" />
                <Label Text="Monster · SOAP .NET · GR09" FontSize="14" TextColor="#A9B7CB" />
            </VerticalStackLayout>
            <BoxView HeightRequest="3" WidthRequest="44" Color="#52E0D2" HorizontalOptions="Start" />

            <Border x:Name="TarjetaInicioSesion" Stroke="#2D3A55" StrokeShape="RoundRectangle 20" BackgroundColor="#121C30" Padding="22">
                <VerticalStackLayout x:Name="PanelInicioSesion" Spacing="12">
                    <Image Source="imagen_inicio_sesion.jpg" HeightRequest="150" WidthRequest="180"
                           Aspect="AspectFill" HorizontalOptions="Center"
                           SemanticProperties.Description="Imagen de Monster" />
                    <Label Text="Iniciar sesión" FontSize="22" FontAttributes="Bold" TextColor="#F4F7FC" />
                    <Label Text="Ingresa tus credenciales para continuar." FontSize="13" TextColor="#A9B7CB" />
                    <Label Text="Usuario" FontAttributes="Bold" TextColor="#F4F7FC" />
                    <Entry x:Name="UsuarioEntry" Text="Monster" Placeholder="Usuario" ReturnType="Next"
                           HeightRequest="48" BackgroundColor="#17243A" TextColor="#F4F7FC"
                           PlaceholderColor="#A9B7CB" />
                    <Label Text="Contraseña" FontAttributes="Bold" TextColor="#F4F7FC" />
                    <Entry x:Name="ContraseniaEntry" Text="Monster9" Placeholder="Contraseña" IsPassword="True" ReturnType="Go"
                           HeightRequest="48" BackgroundColor="#17243A" TextColor="#F4F7FC"
                           PlaceholderColor="#A9B7CB" />
                    <Button Text="Iniciar sesión" Clicked="AlPulsarIniciarSesion"
                            HeightRequest="48" BackgroundColor="#52E0D2" TextColor="#0B1020" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="PanelConversor" IsVisible="False" Stroke="#2D3A55"
                    StrokeShape="RoundRectangle 20" BackgroundColor="#121C30" Padding="22">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Nueva conversión" FontSize="21" FontAttributes="Bold" TextColor="#F4F7FC" />
                    <Label Text="Magnitud" FontAttributes="Bold" TextColor="#F4F7FC" />
                    <Picker x:Name="TipoPicker" Title="Magnitud" SelectedIndexChanged="AlCambiarTipo"
                            HeightRequest="48" BackgroundColor="#17243A" TextColor="#F4F7FC" TitleColor="#A9B7CB">
                        <Picker.Items>
                            <x:String>Longitud</x:String>
                            <x:String>Masa</x:String>
                            <x:String>Temperatura</x:String>
                        </Picker.Items>
                    </Picker>
                    <Label Text="Valor" FontAttributes="Bold" TextColor="#F4F7FC" />
                    <Entry x:Name="ValorEntry" Placeholder="Valor" Keyboard="Numeric"
                           HeightRequest="48" BackgroundColor="#17243A" TextColor="#F4F7FC"
                           PlaceholderColor="#A9B7CB" />
                    <Label Text="Desde" FontAttributes="Bold" TextColor="#F4F7FC" />
                    <Picker x:Name="UnidadInicialPicker" Title="Unidad de origen"
                            HeightRequest="48" BackgroundColor="#17243A" TextColor="#F4F7FC" TitleColor="#A9B7CB" />
                    <Label Text="Hasta" FontAttributes="Bold" TextColor="#F4F7FC" />
                    <Picker x:Name="UnidadFinalPicker" Title="Unidad de destino"
                            HeightRequest="48" BackgroundColor="#17243A" TextColor="#F4F7FC" TitleColor="#A9B7CB" />
                    <Button Text="Convertir" Clicked="AlPulsarConvertir"
                            HeightRequest="48" BackgroundColor="#52E0D2" TextColor="#0B1020" />
                    <Label x:Name="ResultadoLabel" FontSize="20" FontAttributes="Bold" TextColor="#A78BFA" />
                    <BoxView HeightRequest="1" Color="#2D3A55" Margin="0,8" />
                    <Label Text="Cambiar contraseña" FontSize="18" FontAttributes="Bold" TextColor="#F4F7FC" />
                    <Entry x:Name="ContraseniaActualEntry" Placeholder="Contraseña actual" IsPassword="True"
                           HeightRequest="48" BackgroundColor="#17243A" TextColor="#F4F7FC" PlaceholderColor="#A9B7CB" />
                    <Entry x:Name="ContraseniaNuevaEntry" Placeholder="Contraseña nueva" IsPassword="True"
                           HeightRequest="48" BackgroundColor="#17243A" TextColor="#F4F7FC" PlaceholderColor="#A9B7CB" />
                    <Button Text="Actualizar contraseña" Clicked="AlPulsarCambiarContrasenia"
                            BackgroundColor="#17243A" TextColor="#F4F7FC" />
                    <Button Text="Cerrar sesión" Clicked="AlPulsarCerrarSesion"
                            BackgroundColor="#17243A" TextColor="#F4F7FC" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="MensajeLabel" IsVisible="False" Padding="12"
                   FontSize="14" TextColor="#FF8585" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
