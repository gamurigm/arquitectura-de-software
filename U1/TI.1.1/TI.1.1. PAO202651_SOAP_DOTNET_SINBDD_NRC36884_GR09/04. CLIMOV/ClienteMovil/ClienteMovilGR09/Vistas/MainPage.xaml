<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClienteMovilGR09.Vistas.MainPage"
             Title="Conversor de unidades"
             BackgroundColor="#121212">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="Conversor de unidades" FontSize="26" FontAttributes="Bold" TextColor="White" />
                <Label Text="Monster · SOAP .NET · GR09" FontSize="14" TextColor="#B8B8C4" />
            </VerticalStackLayout>

            <Border Stroke="#333333" StrokeShape="RoundRectangle 8" BackgroundColor="#151515" Padding="20">
                <VerticalStackLayout x:Name="PanelInicioSesion" Spacing="10">
                    <Image Source="monsterlogin.jpg" HeightRequest="150" WidthRequest="180"
                           Aspect="AspectFill" HorizontalOptions="Center"
                           SemanticProperties.Description="Imagen de Monster" />
                    <Label Text="Iniciar sesión" FontSize="22" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Ingresa tus credenciales para continuar." FontSize="13" TextColor="#B8B8C4" />
                    <Label Text="Usuario" FontAttributes="Bold" TextColor="White" />
                    <Entry x:Name="UsuarioEntry" Placeholder="Usuario" ReturnType="Next"
                           HeightRequest="48" BackgroundColor="#404040" TextColor="White"
                           PlaceholderColor="#C8C8C8" />
                    <Label Text="Contraseña" FontAttributes="Bold" TextColor="White" />
                    <Entry x:Name="ContraseniaEntry" Placeholder="Contraseña" IsPassword="True" ReturnType="Go"
                           HeightRequest="48" BackgroundColor="#404040" TextColor="White"
                           PlaceholderColor="#C8C8C8" />
                    <Button Text="Iniciar sesión" Clicked="OnIniciarSesionClicked"
                            HeightRequest="48" BackgroundColor="#5B88E5" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="PanelConversor" IsVisible="False" Stroke="#333333"
                    StrokeShape="RoundRectangle 8" BackgroundColor="#151515" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Nueva conversión" FontSize="21" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Magnitud" FontAttributes="Bold" TextColor="White" />
                    <Picker x:Name="TipoPicker" Title="Magnitud" SelectedIndexChanged="OnTipoChanged"
                            HeightRequest="48" BackgroundColor="#404040" TextColor="White" TitleColor="#C8C8C8">
                        <Picker.Items>
                            <x:String>Longitud</x:String>
                            <x:String>Masa</x:String>
                            <x:String>Temperatura</x:String>
                        </Picker.Items>
                    </Picker>
                    <Label Text="Valor" FontAttributes="Bold" TextColor="White" />
                    <Entry x:Name="ValorEntry" Placeholder="Valor" Keyboard="Numeric"
                           HeightRequest="48" BackgroundColor="#404040" TextColor="White"
                           PlaceholderColor="#C8C8C8" />
                    <Label Text="Desde" FontAttributes="Bold" TextColor="White" />
                    <Picker x:Name="UnidadInicialPicker" Title="Unidad de origen"
                            HeightRequest="48" BackgroundColor="#404040" TextColor="White" TitleColor="#C8C8C8" />
                    <Label Text="Hasta" FontAttributes="Bold" TextColor="White" />
                    <Picker x:Name="UnidadFinalPicker" Title="Unidad de destino"
                            HeightRequest="48" BackgroundColor="#404040" TextColor="White" TitleColor="#C8C8C8" />
                    <Button Text="Convertir" Clicked="OnConvertirClicked"
                            HeightRequest="48" BackgroundColor="#5B88E5" TextColor="White" />
                    <Label x:Name="ResultadoLabel" FontSize="20" FontAttributes="Bold" TextColor="#A9BFF4" />
                    <BoxView HeightRequest="1" Color="#333333" Margin="0,8" />
                    <Label Text="Cambiar contraseña" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Entry x:Name="ContraseniaActualEntry" Placeholder="Contraseña actual" IsPassword="True"
                           HeightRequest="48" BackgroundColor="#404040" TextColor="White" PlaceholderColor="#C8C8C8" />
                    <Entry x:Name="ContraseniaNuevaEntry" Placeholder="Contraseña nueva" IsPassword="True"
                           HeightRequest="48" BackgroundColor="#404040" TextColor="White" PlaceholderColor="#C8C8C8" />
                    <Button Text="Actualizar contraseña" Clicked="OnCambiarContraseniaClicked"
                            BackgroundColor="#303030" TextColor="White" />
                    <Button Text="Cerrar sesión" Clicked="OnCerrarSesionClicked"
                            BackgroundColor="#303030" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="MensajeLabel" IsVisible="False" Padding="12"
                   FontSize="14" TextColor="#FF8585" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>