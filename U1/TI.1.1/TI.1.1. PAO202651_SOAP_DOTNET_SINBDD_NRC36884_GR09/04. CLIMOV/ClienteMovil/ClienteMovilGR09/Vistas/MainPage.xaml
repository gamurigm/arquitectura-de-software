<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClienteMovilGR09.Vistas.MainPage"
             Title="Conversor de unidades"
             BackgroundColor="#F3F5F9">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="Conversor de unidades" FontSize="28" FontAttributes="Bold" TextColor="#182230" />
                <Label Text="SOAP · .NET · GR09" FontSize="14" TextColor="#667085" />
            </VerticalStackLayout>

            <Border Padding="20" Stroke="#E4E7EC" StrokeShape="RoundRectangle 16" BackgroundColor="White">
                <VerticalStackLayout x:Name="PanelInicioSesion" Spacing="12">
                    <Label Text="Iniciar sesión" FontSize="20" FontAttributes="Bold" TextColor="#182230" />
                    <Entry x:Name="UsuarioEntry" Placeholder="Usuario" ReturnType="Next" />
                    <Entry x:Name="ContraseniaEntry" Placeholder="Contraseña" IsPassword="True" ReturnType="Go" />
                    <Button Text="Ingresar" Clicked="OnIniciarSesionClicked" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="PanelConversor" IsVisible="False" Padding="20" Stroke="#E4E7EC" StrokeShape="RoundRectangle 16" BackgroundColor="White">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Conversión" FontSize="20" FontAttributes="Bold" TextColor="#182230" />
                    <Picker x:Name="TipoPicker" Title="Tipo de conversión" SelectedIndexChanged="OnTipoChanged">
                        <Picker.Items>
                            <x:String>Longitud</x:String>
                            <x:String>Masa</x:String>
                            <x:String>Temperatura</x:String>
                        </Picker.Items>
                    </Picker>
                    <Entry x:Name="ValorEntry" Placeholder="Valor" Keyboard="Numeric" />
                    <Picker x:Name="UnidadInicialPicker" Title="Unidad de origen" />
                    <Picker x:Name="UnidadFinalPicker" Title="Unidad de destino" />
                    <Button Text="Convertir" Clicked="OnConvertirClicked" />
                    <Label x:Name="ResultadoLabel" FontSize="20" FontAttributes="Bold" TextColor="#175CD3" />

                    <BoxView HeightRequest="1" Color="#EAECF0" Margin="0,8" />
                    <Label Text="Cambiar contraseña" FontSize="18" FontAttributes="Bold" TextColor="#182230" />
                    <Entry x:Name="ContraseniaActualEntry" Placeholder="Contraseña actual" IsPassword="True" />
                    <Entry x:Name="ContraseniaNuevaEntry" Placeholder="Contraseña nueva" IsPassword="True" />
                    <Button Text="Actualizar contraseña" Clicked="OnCambiarContraseniaClicked" BackgroundColor="#475467" />
                    <Button Text="Cerrar sesión" Clicked="OnCerrarSesionClicked" BackgroundColor="#D92D20" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="MensajeLabel" IsVisible="False" Padding="12" FontSize="14" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
