@model ConversionViewModel
@{
    ViewData["Title"] = "Conversor de Unidades";
    var autenticado = ViewBag.Autenticado is true;
}
<div class="container py-4" style="max-width: 720px">
    <header class="mb-4">
        <h1 class="h2">Conversor de Unidades</h1>
        <p class="text-secondary">Monster · SOAP .NET · GR09</p>
    </header>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success" role="status">@mensaje</div>
    }

    @if (!autenticado)
    {
        <section class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Iniciar sesión</h2>
                <form asp-action="IniciarSesion" method="post">
                    <div class="mb-3">
                        <label class="form-label" for="Usuario">Usuario</label>
                        <input class="form-control" id="Usuario" name="Usuario" autocomplete="username" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Contrasenia">Contraseña</label>
                        <input class="form-control" id="Contrasenia" name="Contrasenia" type="password"
                               autocomplete="current-password" required />
                    </div>
                    <button class="btn btn-primary" type="submit">Iniciar sesión</button>
                </form>
            </div>
        </section>
    }
    else
    {
        <section class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h5">Nueva conversión</h2>
                <form asp-action="Convertir" method="post">
                    <div class="mb-3">
                        <label asp-for="Tipo" class="form-label">Magnitud</label>
                        <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoConversion>()"
                                class="form-select" id="Tipo"></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Valor" class="form-label">Valor</label>
                        <input asp-for="Valor" class="form-control" type="number" step="any" required />
                        <span asp-validation-for="Valor" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label asp-for="UnidadInicial" class="form-label">Unidad inicial</label>
                            <select asp-for="UnidadInicial" asp-items="ViewBag.Unidades"
                                    class="form-select" id="UnidadInicial"></select>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label asp-for="UnidadFinal" class="form-label">Unidad final</label>
                            <select asp-for="UnidadFinal" asp-items="ViewBag.Unidades"
                                    class="form-select" id="UnidadFinal"></select>
                        </div>
                    </div>
                    <button class="btn btn-primary" type="submit">Convertir</button>
                </form>
                @if (!string.IsNullOrWhiteSpace(Model.Resultado))
                {
                    <p class="fs-5 fw-semibold text-success mt-3" role="status">Resultado: @Model.Resultado</p>
                }
            </div>
        </section>

        <section class="card shadow-sm mb-3">
            <div class="card-body">
                <h2 class="h6">Cambiar contraseña</h2>
                <form asp-action="CambiarContrasenia" method="post">
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label class="form-label" for="ContraseniaActual">Contraseña actual</label>
                            <input class="form-control" id="ContraseniaActual" name="ContraseniaActual"
                                   type="password" autocomplete="current-password" required />
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label class="form-label" for="ContraseniaNueva">Contraseña nueva</label>
                            <input class="form-control" id="ContraseniaNueva" name="ContraseniaNueva"
                                   type="password" autocomplete="new-password" required />
                        </div>
                    </div>
                    <button class="btn btn-outline-primary" type="submit">Actualizar contraseña</button>
                </form>
            </div>
        </section>
        <form asp-action="CerrarSesion" method="post">
            <button class="btn btn-outline-secondary" type="submit">Cerrar sesión</button>
        </form>
    }
</div>

@if (autenticado)
{
    <script>
        const catalogo = @Html.Raw((string)ViewBag.CatalogoJson);
        const magnitud = document.getElementById("Tipo");
        const unidades = [document.getElementById("UnidadInicial"), document.getElementById("UnidadFinal")];
        function actualizarUnidades() {
            const opciones = catalogo[magnitud.value];
            for (const selector of unidades) {
                const anterior = selector.value;
                selector.replaceChildren(...opciones.map(u => new Option(u.etiqueta, u.codigo)));
                if (opciones.some(u => u.codigo === anterior)) selector.value = anterior;
            }
        }
        magnitud.addEventListener("change", actualizarUnidades);
        actualizarUnidades();
    </script>
}
