<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ClienteMovilGR09.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Conversor GR09"
    BackgroundColor="#F2F4F8">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="18">
            <Border Padding="22" StrokeThickness="0" BackgroundColor="#15324B" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="5">
                    <Label Text="CONVERSOR DE UNIDADES" TextColor="White" FontSize="22" FontAttributes="Bold" />
                    <Label Text="GR09 · REST .NET" TextColor="#B7CAD8" FontSize="14" />
                </VerticalStackLayout>
            </Border>
            <Border x:Name="panelLogin" Padding="22" StrokeThickness="0" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Iniciar sesión" TextColor="#15324B" FontSize="21" FontAttributes="Bold" />
                    <Entry x:Name="txtUsuario" Placeholder="Usuario" HeightRequest="48" />
                    <Entry x:Name="txtClave" Placeholder="Clave" IsPassword="True" HeightRequest="48" />
                    <Button Text="Ingresar" BackgroundColor="#176B87" TextColor="White" HeightRequest="48" Clicked="IniciarSesion_Clicked" />
                    <Label x:Name="lblMensajeLogin" TextColor="#A63535" FontSize="13" />
                </VerticalStackLayout>
            </Border>
            <Border x:Name="panelConversion" IsVisible="False" Padding="22" StrokeThickness="0" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Conversión" TextColor="#15324B" FontSize="21" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Salir" BackgroundColor="#EDF2F5" TextColor="#24465D" Clicked="CerrarSesion_Clicked" />
                    </Grid>
                    <Label x:Name="lblSesion" TextColor="#536878" FontSize="13" />
                    <Picker x:Name="pickerMagnitud" Title="Magnitud" HeightRequest="48" SelectedIndexChanged="Magnitud_SelectionChanged" />
                    <Entry x:Name="txtValor" Placeholder="Valor" Keyboard="Numeric" HeightRequest="48" />
                    <Picker x:Name="pickerOrigen" Title="Unidad de origen" HeightRequest="48" />
                    <Picker x:Name="pickerDestino" Title="Unidad de destino" HeightRequest="48" />
                    <Button Text="Convertir" BackgroundColor="#176B87" TextColor="White" HeightRequest="48" Clicked="Convertir_Clicked" />
                    <Border Padding="14" StrokeThickness="0" BackgroundColor="#EEF4F7" StrokeShape="RoundRectangle 8">
                        <Label x:Name="lblResultado" Text="El resultado aparecerá aquí." TextColor="#15324B" FontSize="16" />
                    </Border>
                    <Label x:Name="lblMensaje" TextColor="#A63535" FontSize="13" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
