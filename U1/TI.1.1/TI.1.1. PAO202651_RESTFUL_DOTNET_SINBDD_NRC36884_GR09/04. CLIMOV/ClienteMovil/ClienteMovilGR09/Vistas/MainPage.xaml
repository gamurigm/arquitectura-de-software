<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ClienteMovilGR09.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Conversor de unidades"
             BackgroundColor="#121212">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="Conversor de unidades" TextColor="White" FontSize="26" FontAttributes="Bold" />
                <Label Text="Monster · REST .NET · GR09" TextColor="#B8B8C4" FontSize="14" />
            </VerticalStackLayout>

            <Border x:Name="panelLogin" Stroke="#333333" BackgroundColor="#151515"
                    StrokeShape="RoundRectangle 8" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Image Source="monsterlogin.jpg" HeightRequest="150" WidthRequest="180"
                           Aspect="AspectFill" HorizontalOptions="Center"
                           SemanticProperties.Description="Imagen de Monster" />
                    <Label Text="Iniciar sesión" TextColor="White" FontSize="22" FontAttributes="Bold" />
                    <Label Text="Ingresa tus credenciales para continuar." TextColor="#B8B8C4" FontSize="13" />
                    <Label Text="Usuario" TextColor="White" FontAttributes="Bold" />
                    <Entry x:Name="txtUsuario" Placeholder="Usuario" HeightRequest="48"
                           BackgroundColor="#404040" TextColor="White" PlaceholderColor="#C8C8C8" />
                    <Label Text="Contraseña" TextColor="White" FontAttributes="Bold" />
                    <Entry x:Name="txtClave" Placeholder="Contraseña" IsPassword="True" HeightRequest="48"
                           BackgroundColor="#404040" TextColor="White" PlaceholderColor="#C8C8C8" />
                    <Button Text="Iniciar sesión" HeightRequest="48" BackgroundColor="#5B88E5"
                            TextColor="White" Clicked="IniciarSesion_Clicked" />
                    <Label x:Name="lblMensajeLogin" TextColor="#FF8585" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="panelConversion" IsVisible="False" Stroke="#333333"
                    BackgroundColor="#151515" StrokeShape="RoundRectangle 8" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Nueva conversión" TextColor="White" FontSize="21"
                               FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Cerrar sesión" BackgroundColor="#303030"
                                TextColor="White" Clicked="CerrarSesion_Clicked" />
                    </Grid>
                    <Label x:Name="lblSesion" TextColor="#B8B8C4" FontSize="13" />
                    <Label Text="Magnitud" TextColor="White" FontAttributes="Bold" />
                    <Picker x:Name="pickerMagnitud" Title="Magnitud" HeightRequest="48"
                            BackgroundColor="#404040" TextColor="White" TitleColor="#C8C8C8"
                            SelectedIndexChanged="Magnitud_SelectionChanged" />
                    <Label Text="Valor" TextColor="White" FontAttributes="Bold" />
                    <Entry x:Name="txtValor" Placeholder="Valor" Keyboard="Numeric" HeightRequest="48"
                           BackgroundColor="#404040" TextColor="White" PlaceholderColor="#C8C8C8" />
                    <Label Text="Desde" TextColor="White" FontAttributes="Bold" />
                    <Picker x:Name="pickerOrigen" Title="Unidad de origen" HeightRequest="48"
                            BackgroundColor="#404040" TextColor="White" TitleColor="#C8C8C8" />
                    <Label Text="Hasta" TextColor="White" FontAttributes="Bold" />
                    <Picker x:Name="pickerDestino" Title="Unidad de destino" HeightRequest="48"
                            BackgroundColor="#404040" TextColor="White" TitleColor="#C8C8C8" />
                    <Button Text="Convertir" BackgroundColor="#5B88E5" TextColor="White"
                            HeightRequest="48" Clicked="Convertir_Clicked" />
                    <Border Padding="14" Stroke="#333333" BackgroundColor="#202020"
                            StrokeShape="RoundRectangle 4">
                        <Label x:Name="lblResultado" Text="El resultado aparecerá aquí."
                               TextColor="#A9BFF4" FontSize="16" />
                    </Border>
                    <Label x:Name="lblMensaje" TextColor="#FF8585" FontSize="13" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
