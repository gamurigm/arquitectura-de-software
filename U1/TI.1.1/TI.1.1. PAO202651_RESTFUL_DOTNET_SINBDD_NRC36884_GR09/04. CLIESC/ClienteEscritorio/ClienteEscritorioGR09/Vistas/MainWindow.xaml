<Window x:Class="ClienteEscritorioGR09.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conversor de Unidades GR09" Height="650" Width="900"
        MinHeight="580" MinWidth="760" WindowStartupLocation="CenterScreen"
        Background="#F2F4F8">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="24" CornerRadius="12" Background="#15324B">
            <StackPanel>
                <TextBlock Text="CONVERSOR DE UNIDADES" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="GR09 · REST .NET" Foreground="#B7CAD8" FontSize="14" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Border x:Name="panelLogin" Padding="28" CornerRadius="12" Background="White" VerticalAlignment="Top">
                <StackPanel MaxWidth="440" HorizontalAlignment="Center">
                    <TextBlock Text="Iniciar sesión" FontSize="21" FontWeight="SemiBold" Foreground="#15324B" Margin="0,0,0,20" />
                    <TextBlock Text="Usuario" Foreground="#354B5E" />
                    <TextBox x:Name="txtUsuario" Height="38" Padding="10,7" Margin="0,6,0,14" />
                    <TextBlock Text="Clave" Foreground="#354B5E" />
                    <PasswordBox x:Name="txtClave" Height="38" Padding="10,7" Margin="0,6,0,18" />
                    <Button Content="Ingresar" Height="40" Background="#176B87" Foreground="White" FontWeight="SemiBold" Click="IniciarSesion_Click" />
                    <TextBlock x:Name="lblMensajeLogin" Foreground="#A63535" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="panelConversion" Padding="28" CornerRadius="12" Background="White" VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel Margin="0,0,0,22">
                        <TextBlock Text="Conversión" FontSize="21" FontWeight="SemiBold" Foreground="#15324B" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Cerrar sesión" Padding="14,8" Click="CerrarSesion_Click" />
                    </DockPanel>
                    <TextBlock x:Name="lblSesion" Foreground="#536878" Margin="0,0,0,18" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Magnitud" Foreground="#354B5E" />
                            <ComboBox x:Name="cmbMagnitud" Height="38" Margin="0,6,0,16" SelectionChanged="Magnitud_SelectionChanged" />
                            <TextBlock Text="Valor" Foreground="#354B5E" />
                            <TextBox x:Name="txtValor" Height="38" Padding="10,7" Margin="0,6,0,16" />
                            <TextBlock Text="Unidad de origen" Foreground="#354B5E" />
                            <ComboBox x:Name="cmbOrigen" Height="38" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Selecciona las unidades" Foreground="#354B5E" />
                            <TextBlock Text="La conversión se procesa en el servidor REST." TextWrapping="Wrap" Foreground="#536878" Margin="0,6,0,16" />
                            <TextBlock Text="Unidad de destino" Foreground="#354B5E" Margin="0,58,0,0" />
                            <ComboBox x:Name="cmbDestino" Height="38" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                    <Button Content="Convertir" Height="42" Margin="0,22,0,0" Background="#176B87" Foreground="White" FontWeight="SemiBold" Click="Convertir_Click" />
                    <Border Background="#EEF4F7" Padding="14" CornerRadius="8" Margin="0,18,0,0">
                        <TextBlock x:Name="lblResultado" Text="El resultado aparecerá aquí." Foreground="#15324B" FontSize="16" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock x:Name="lblMensaje" Foreground="#A63535" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
