<Window x:Class="ClienteEscritorioGR09.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conversor de unidades Monster GR09"
        Height="660" Width="820" MinHeight="570" MinWidth="620"
        WindowStartupLocation="CenterScreen" Background="#121212">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#5B88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border MaxWidth="760" Margin="24" Padding="26" Background="#151515"
                BorderBrush="#333333" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Conversor de unidades" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Monster · REST .NET · GR09" Margin="0,4,0,20" Foreground="#B8B8C4"/>

                <Grid x:Name="panelLogin">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="172"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" MaxWidth="330" VerticalAlignment="Center">
                        <TextBlock Text="Iniciar sesión" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Ingresa tus credenciales para continuar."
                                   Margin="0,4,0,18" Foreground="#B8B8C4"/>
                        <TextBlock Text="Usuario" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtUsuario" Margin="0,5,0,12"/>
                        <TextBlock Text="Contraseña" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="txtClave" Margin="0,5,0,18"/>
                        <Button Content="Iniciar sesión" Click="IniciarSesion_Click"/>
                        <TextBlock x:Name="lblMensajeLogin" Foreground="#FF8585"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" BorderBrush="#333333" BorderThickness="1">
                        <Image Source="pack://application:,,,/Resources/Images/monsterlogin.jpg"
                               Width="172" Height="300" Stretch="UniformToFill" ToolTip="Monster"/>
                    </Border>
                </Grid>

                <StackPanel x:Name="panelConversion" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="Cerrar sesión" Background="#303030"
                                Click="CerrarSesion_Click"/>
                        <TextBlock Text="Nueva conversión" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="lblSesion" Foreground="#B8B8C4" Margin="0,0,0,18"/>
                    <TextBlock Text="Magnitud" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbMagnitud" Margin="0,5,0,12"
                              SelectionChanged="Magnitud_SelectionChanged"/>
                    <TextBlock Text="Valor" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtValor" Margin="0,5,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Desde" FontWeight="SemiBold"/>
                            <ComboBox x:Name="cmbOrigen" Margin="0,5,0,14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hasta" FontWeight="SemiBold"/>
                            <ComboBox x:Name="cmbDestino" Margin="0,5,0,14"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="Convertir" Click="Convertir_Click"/>
                    <Border Background="#202020" BorderBrush="#333333" BorderThickness="1"
                            Padding="14" CornerRadius="4" Margin="0,18,0,0">
                        <TextBlock x:Name="lblResultado" Text="El resultado aparecerá aquí."
                                   Foreground="#A9BFF4" FontSize="16" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="lblMensaje" Foreground="#FF8585" TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
