<Window x:Class="ClienteEscritorioGR09.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conversor de unidades Monster GR09"
        Height="700" Width="920" MinHeight="620" MinWidth="700"
        WindowStartupLocation="CenterScreen" Background="#0B1020">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#17243A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D3A55"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#17243A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D3A55"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#17243A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D3A55"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#52E0D2"/>
            <Setter Property="Foreground" Value="#0B1020"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border MaxWidth="860" Margin="30" Padding="32" Background="#121C30"
                BorderBrush="#2D3A55" BorderThickness="1" CornerRadius="20">
            <StackPanel>
                <TextBlock Text="Conversor de unidades" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Monster · REST .NET · GR09" Margin="0,6,0,24" Foreground="#A9B7CB"/>
                <Border Width="44" Height="3" HorizontalAlignment="Left" Background="#52E0D2" CornerRadius="2" Margin="0,-14,0,22"/>

                <Grid x:Name="panelLogin">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="172"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" MaxWidth="330" VerticalAlignment="Center">
                        <TextBlock Text="Iniciar sesión" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Ingresa tus credenciales para continuar."
                                   Margin="0,4,0,18" Foreground="#A9B7CB"/>
                        <TextBlock Text="Usuario" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtUsuario" Text="Monster" Margin="0,6,0,16"/>
                        <TextBlock Text="Contraseña" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="txtClave" Password="Monster9" Margin="0,6,0,20"/>
                        <Button Content="Iniciar sesión" Click="IniciarSesion_Click"/>
                        <TextBlock x:Name="lblMensajeLogin" Foreground="#FF8585"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" BorderBrush="#2D3A55" BorderThickness="1">
                        <Image Source="pack://application:,,,/Resources/Images/imagen_inicio_sesion.jpg"
                               Width="172" Height="300" Stretch="UniformToFill" ToolTip="Monster"/>
                    </Border>
                </Grid>

                <StackPanel x:Name="panelConversion" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="Cerrar sesión" Background="#17243A" Foreground="#F4F7FC"
                                Click="CerrarSesion_Click"/>
                        <TextBlock Text="Nueva conversión" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="lblSesion" Foreground="#A9B7CB" Margin="0,0,0,18"/>
                    <TextBlock Text="Magnitud" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbMagnitud" Margin="0,5,0,12"
                              SelectionChanged="Magnitud_SelectionChanged"/>
                    <TextBlock Text="Valor" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtValor" Margin="0,5,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Desde" FontWeight="SemiBold"/>
                            <ComboBox x:Name="cmbOrigen" Margin="0,5,0,14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hasta" FontWeight="SemiBold"/>
                            <ComboBox x:Name="cmbDestino" Margin="0,5,0,14"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="Convertir" Click="Convertir_Click"/>
                    <Border Background="#17243A" BorderBrush="#2D3A55" BorderThickness="1"
                            Padding="18" CornerRadius="14" Margin="0,20,0,0">
                        <TextBlock x:Name="lblResultado" Text="El resultado aparecerá aquí."
                                   Foreground="#52E0D2" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="lblMensaje" Foreground="#FF8585" TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
