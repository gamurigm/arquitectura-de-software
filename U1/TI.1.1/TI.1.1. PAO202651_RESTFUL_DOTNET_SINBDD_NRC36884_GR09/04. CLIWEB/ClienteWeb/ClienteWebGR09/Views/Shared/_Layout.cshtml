<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Conversor GR09</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-controller="Home" asp-action="Index">Conversor de unidades <span>Monster</span></a>
        <span class="header-caption">REST .NET · GR09</span>
    </header>
    <main class="page-shell">
        @RenderBody()
    </main>
    <footer class="site-footer">Conversor de unidades · REST .NET · GR09</footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>