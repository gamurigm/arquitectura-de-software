@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}
<header class="page-intro">
    <h1>Conversor de Unidades</h1>
    <p class="muted">Monster · REST .NET · GR09</p>
</header>
<section class="auth-card login-shell">
    <div class="login-copy">
    <h1>Iniciar sesión</h1>
    <p class="muted">Ingresa tus credenciales para continuar.</p>
    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="notice">@mensaje</div>
    }
    <form asp-action="Login" method="post" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="form-error"></div>
        <label asp-for="Usuario">Usuario</label>
        <input asp-for="Usuario" autocomplete="username" class="field" />
        <span asp-validation-for="Usuario" class="form-error"></span>
        <label asp-for="Clave">Contraseña</label>
        <input asp-for="Clave" autocomplete="current-password" class="field" />
        <span asp-validation-for="Clave" class="form-error"></span>
        <button class="button button-primary" type="submit">Iniciar sesión</button>
    </form>
    </div>
    <img class="monster-image" src="~/images/monsterlogin.jpg" alt="Monster, imagen del conversor" />
</section>
