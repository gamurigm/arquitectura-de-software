<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
	</appSettings>
	<system.web>
		<compilation debug="true" />
	</system.web>

	<system.serviceModel>
		<services>
			<service name="ec.edu.monster.controlador.ServicioMonster">
				<host>
					<baseAddresses>
						<add baseAddress="http://localhost:8733/Design_Time_Addresses/ServidorMonster/ServicioMonster/" />
					</baseAddresses>
				</host>

				<endpoint address=""
						  binding="basicHttpBinding"
						  contract="ec.edu.monster.modelo.IServicioMonster">
					<identity>
						<dns value="localhost" />
					</identity>
				</endpoint>

				<endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
			</service>
		</services>

		<behaviors>
			<serviceBehaviors>
				<behavior>
					<serviceMetadata httpGetEnabled="True" httpsGetEnabled="True"/>
					<serviceDebug includeExceptionDetailInFaults="True" />
				</behavior>
			</serviceBehaviors>
		</behaviors>
	</system.serviceModel>
</configuration>